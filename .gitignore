# ==============================================================================
# Git Ignore — StudyBuddy Monorepo (Root, Backend, Frontend, AdminPanel)
# ==============================================================================

# Dependencies (blocks node_modules everywhere across all subdirectories)
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build & compiled outputs
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
out/

# Environment configurations (keep .env.example tracked)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage & test output
coverage/
**/coverage/
*.lcov
.nyc_output

# IDE, Editor & OS artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Caches & temporary files
.eslintcache
.stylelintcache
*.tsbuildinfo
.turbo/
