# ===========================
# Environment — StudyBuddy Backend
# ===========================

# Neon PostgreSQL connection string (pooled)
DATABASE_URL=

# Neon direct connection (for migrations)
DIRECT_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: max file upload size (bytes)
MAX_FILE_SIZE=52428800
